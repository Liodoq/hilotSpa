# ============================================================
# HilotSpa — TEMPLATE. Copy to .env and fill in real values. Safe to commit.
# Copy .env.example -> .env and fill in real values.
# ============================================================

# --- This branch node's identity (used by Sprint 3 sync) ---
NODE_ID=bulan-01
NODE_NAME=Bulan, Sorsogon

# --- Application ---
SERVER_PORT=8080

# --- PostgreSQL (consumed by Spring) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hilotspa_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# --- PostgreSQL (consumed by docker-compose to create the container) ---
POSTGRES_DB=hilotspa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here

# --- Redis (Sprint 2: temporary resource locking) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security (Sprint 0.6) ---
# Generate a long random string. Must be >= 32 chars for HS256.
JWT_SECRET=generate_a_long_random_string_here
JWT_EXPIRATION_MS=86400000

# --- AI (Sprint 2) ---
GEMINI_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/hilotspa

# --- Frontend origin for CORS ---
FRONTEND_ORIGIN=http://localhost:4200

SPRING_PROFILES_ACTIVE=dev
